# Required
WVD_SECRET_KEY=your-django-secret-key-here

# Optional (shown with defaults)
WVD_DEBUG=False
WVD_ALLOWED_HOSTS=localhost,127.0.0.1
# WVD_CSRF_TRUSTED_ORIGINS=https://weather.example.com  # required once served over HTTPS via Nginx
WVD_SESSION_COOKIE_AGE=1209600
WVD_SECURE_HSTS_SECONDS=31536000
WVD_TRUSTED_PROXY_IPS=127.0.0.1
WEATHER_RATE_LIMIT=15/m
# WVD_REDIS_URL=redis://localhost:6379/0  # set to enable Redis (required for multi-worker)
# WVD_DIGITRAFFIC_BASE_URL=http://127.0.0.1:18766  # test-only; points at tests/robot/fixtures/fixture_server.py
